#!/bin/sh
### BEGIN INIT INFO
# Provides:          dnsmasq
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: DNS and DHCP server
# Description:       DNS forwarder and DHCP server
### END INIT INFO

DAEMON=/usr/bin/dnsmasq
NAME=dnsmasq
PIDFILE=/var/run/$NAME.pid
# 168.63.129.16 is Azure DNS server
DNSMASQ_OPTS="-S 168.63.129.16 --no-resolv --listen-address=127.0.0.1 --dns-forward-max=5000 --log-facility=/var/log/dnsmasq.log --log-queries"

case "$1" in
    start)
        echo "Starting $NAME..."

        mkdir -p /var/log
        touch /var/log/dnsmasq.log

        # Ensure we are using dnsmasq to resolve
        # Sometimes /etc/resolv.conf gets overwritten at boot
        echo "nameserver 127.0.0.1" > /etc/resolv.conf

        start-stop-daemon --start --quiet --pidfile $PIDFILE --exec $DAEMON -- $DNSMASQ_OPTS
        echo "done."
        ;;
    stop)
        echo "Stopping $NAME..."
        start-stop-daemon --stop --quiet --pidfile $PIDFILE --name $NAME
        echo "done."
        ;;
    restart)
        echo "Restarting $NAME..."
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f $PIDFILE ]; then
            PID=$(cat $PIDFILE)
            if kill -0 $PID 2>/dev/null; then
                echo "$NAME is running (PID: $PID)"
                exit 0
            else
                echo "$NAME is not running but PID file exists"
                exit 1
            fi
        else
            echo "$NAME is not running"
            exit 3
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
